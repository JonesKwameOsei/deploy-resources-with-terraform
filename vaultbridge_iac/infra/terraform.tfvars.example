###############################################################################
# terraform.tfvars.example
#
# SETUP:
#   1. Copy this file:  cp terraform.tfvars.example terraform.tfvars
#   2. Fill in your actual values
#   3. terraform.tfvars is gitignored — NEVER commit it
#
# CREDENTIALS: db_username and db_password are NOT set here and do not exist
#   as Terraform variables. They are generated randomly by the secrets module
#   and stored directly in AWS Secrets Manager. No human ever types them.
###############################################################################

# General
environment  = "dev"
aws_region   = "us-east-1"
project_name = "vaultbridge"

# Networking
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
availability_zones   = ["us-east-1a", "us-east-1b"]

# Compute
ec2_instance_type = "t3.micro"
key_pair_name     = "vaultbridge-dev"

# Restrict SSH to your IP only. Find your IP: curl ifconfig.me
allowed_ssh_cidr = "YOUR_IP_ADDRESS/32"

# Database
db_instance_class = "db.t3.micro"
db_name           = "vaultbridge"

db_config = {
  engine                = "postgres"
  engine_version        = "16"
  allocated_storage     = 20
  max_allocated_storage = 100
}

# Secrets Manager
# secret_rotation_days is commented out until rotation Lambda is enabled
# secret_rotation_days        = 30
secret_recovery_window_days = 7
