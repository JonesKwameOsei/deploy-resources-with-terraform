# =============================================================================
# VaultBridge — Runtime Environment Configuration Template
# =============================================================================
#
# SETUP:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values from your AWS environment
#   3. .env is gitignored — NEVER commit it
#
# HOW CREDENTIALS WORK IN PRODUCTION:
#   DB credentials (username/password) are NOT stored here.
#   The application retrieves them at runtime from AWS Secrets Manager
#   using the SDK. The only thing stored here is the secret ARN so the
#   application knows WHERE to look.
#
#   Retrieve the secret ARN after terraform apply:
#     terraform output db_secret_arn
#
# =============================================================================

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# ── Secrets Manager ───────────────────────────────────────────────────────────
# ARN of the Secrets Manager secret containing DB credentials.
# The application calls GetSecretValue on this ARN at startup.
# Get this value from: terraform output db_secret_arn
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:vaultbridge/dev/db-credentials-XXXXXX

# ── Database (non-sensitive config) ──────────────────────────────────────────
# Host and port are not secret — they are infrastructure endpoints.
# Username and password come from Secrets Manager, not from here.
# Get DB_HOST from: terraform output rds_endpoint
DB_HOST=vaultbridge-dev-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=vaultbridge

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=dev
APP_PORT=8080
LOG_LEVEL=info

# ── Operator Network ──────────────────────────────────────────────────────────
# Your current public IP in CIDR notation. Used to restrict SSH (port 22) on
# the EC2 security group to your machine only — never 0.0.0.0/0.
#
# Find your IP:  curl -s ifconfig.me
# Then set:      MY_IP=203.0.113.5/32
#
# This value feeds allowed_ssh_cidr in terraform.tfvars. After updating it,
# run the one-liner below to sync terraform.tfvars, then re-run terraform apply
# to update the security group rule live in AWS.
#
# Sync command (run from infra/ directory):
#   source .env && sed -i "s|allowed_ssh_cidr.*|allowed_ssh_cidr = \"$MY_IP\"|" terraform.tfvars
MY_IP=203.0.113.5/32

